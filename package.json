{
  "name": "dsh-douyin-life",
  "version": "0.2.1-1",
  "description": "DSH 插件：每天替你刷一轮抖音 —— 看视频读评论挑出值得的、写一份日报；私信集中在一个窗口、分享卡片可互相读、表情包走本地图库",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "comfyui",
    "mcp",
    "duty",
    "automation"
  ],
  "license": "MIT",
  "author": "TiAmoSS (original) / cixinshang (fork)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cixinshang/dsh-douyin-life-plus.git"
  },
  "homepage": "https://github.com/cixinshang/dsh-douyin-life-plus",
  "bugs": {
    "url": "https://github.com/cixinshang/dsh-douyin-life-plus/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "prompts/",
    "docs/AGENT_ONBOARDING.md",
    "video-understanding-lab/",
    "vendor/douyin-mcp/mcp_server.py",
    "vendor/douyin-mcp/requirements.txt",
    "README.md",
    "SPEC.md",
    "LICENSE",
    "vendor/douyin-mcp/smoke.py",
    "market-entry.yml",
    "selfcheck.mjs",
    "screenshots.json",
    "assets/"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
